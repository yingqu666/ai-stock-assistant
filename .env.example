PORT=8787
NODE_ENV=production
TZ=Asia/Shanghai

# Frontend domains allowed to call the API.
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-app.vercel.app

# Basic API protection.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Supabase PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=8000

# Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# AI provider. Keep fallback if the model is not ready.
AI_MODE=fallback
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
AI_API_KEY=

# SMS provider. mock is safe for development; aliyun/tencent are reserved.
SMS_PROVIDER=mock
SMS_MOCK_CODE=888888
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=

# Server-side report scheduler.
ENABLE_SCHEDULER=true
